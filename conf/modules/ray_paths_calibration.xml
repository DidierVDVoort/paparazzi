        <dl_setting var="white.cb_max" min="0" step="1" max="255" shortname="white_cb_max"/>
        <dl_setting var="white.cr_min" min="0" step="1" max="255" shortname="white_cr_min"/>
        <dl_setting var="white.cr_max" min="0" step="1" max="255" shortname="white_cr_max"/>
        <dl_setting var="white.draw" min="0" step="1" max="1" values="False|True" shortname="white_draw"/>
      </dl_settings>
    </dl_settings>
  </settings>

  <dep>
    <depends>video_thread</depends>
  </dep>

  <header>
    <file name="ray_paths_calibration.h"/>
  </header>

  <init fun="ray_paths_calibration_init()"/>
  <periodic fun="ray_paths_calibration_periodic()" freq="50"/>
  <makefile target="ap|nps">
    <file name="ray_paths_calibration.c"/>
  </makefile>
</module>

