<!DOCTYPE module SYSTEM "module.dtd">

<module name="ray_paths">
  <doc>
    <description>Ray Path Finder
    Detects the best path by casting rays and giving them a score

    </description>
    <define name="RAY_PATH_FINDER_CAMERA1" value="front_camera|bottom_camera" description="Video device to use"/>
    <define name="RAY_PATH_FINDER_FPS1" value="0" description="Desired FPS (0: camera rate)"/>

    <define name="RAY_PATH_FINDER_GREEN_LUM" value="0" description="Green mean luminance"/>
    <define name="RAY_PATH_FINDER_GREEN_CB" value="0" description="Green mean blue chroma"/>
    <define name="RAY_PATH_FINDER_GREEN_CR" value="0" description="Green mean red chroma"/>
    <define name="RAY_PATH_FINDER_GREEN_MARGIN_LUM" value="0" description="Green luminance margin"/>
    <define name="RAY_PATH_FINDER_GREEN_MARGIN_CB" value="0" description="Green blue chroma margin"/>
    <define name="RAY_PATH_FINDER_GREEN_MARGIN_CR" value="0" description="Green red chroma margin"/>

    <define name="RAY_PATH_FINDER_ORANGE_LUM" value="0" description="Orange mean luminance"/>
    <define name="RAY_PATH_FINDER_ORANGE_CB" value="0" description="Orange mean blue chroma"/>
    <define name="RAY_PATH_FINDER_ORANGE_CR" value="0" description="Orange mean red chroma"/>
    <define name="RAY_PATH_FINDER_ORANGE_MARGIN_LUM" value="0" description="Orange luminance margin"/>
    <define name="RAY_PATH_FINDER_ORANGE_MARGIN_CB" value="0" description="Orange blue chroma margin"/>
    <define name="RAY_PATH_FINDER_ORANGE_MARGIN_CR" value="0" description="Orange red chroma margin"/>

    <define name="RAY_PATH_FINDER_PURPLE_LUM" value="0" description="Purple mean luminance"/>
    <define name="RAY_PATH_FINDER_PURPLE_CB" value="0" description="Purple mean blue chroma"/>
    <define name="RAY_PATH_FINDER_PURPLE_CR" value="0" description="Purple mean red chroma"/>
    <define name="RAY_PATH_FINDER_PURPLE_MARGIN_LUM" value="0" description="Purple luminance margin"/>
    <define name="RAY_PATH_FINDER_PURPLE_MARGIN_CB" value="0" description="Purple blue chroma margin"/>
    <define name="RAY_PATH_FINDER_PURPLE_MARGIN_CR" value="0" description="Purple red chroma margin"/>

    <define name="RAY_PATH_FINDER_BROWN_LUM" value="0" description="Brown mean luminance"/>
    <define name="RAY_PATH_FINDER_BROWN_CB" value="0" description="Brown mean blue chroma"/>
    <define name="RAY_PATH_FINDER_BROWN_CR" value="0" description="Brown mean red chroma"/>
    <define name="RAY_PATH_FINDER_BROWN_MARGIN_LUM" value="0" description="Brown luminance margin"/>
    <define name="RAY_PATH_FINDER_BROWN_MARGIN_CB" value="0" description="Brown blue chroma margin"/>
    <define name="RAY_PATH_FINDER_BROWN_MARGIN_CR" value="0" description="Brown red chroma margin"/>
  </doc>

 <settings>
    <dl_settings>
      <dl_settings name="RayPathFinder">

        <dl_setting var="turning_threshold" min="-20" step="1" max="20" shortname="turning threshold"/>

        <dl_setting var="green.lum" min="0" step="1" max="255" shortname="green_y"/>
        <dl_setting var="green.cb" min="0" step="1" max="255" shortname="green_u"/>
        <dl_setting var="green.cr" min="0" step="1" max="255" shortname="green_v"/>
        <dl_setting var="green.margin_lum" min="0" step="1" max="255" shortname="green_margin_lum"/>
        <dl_setting var="green.margin_cb" min="0" step="1" max="255" shortname="green_margin_cb"/>
        <dl_setting var="green.margin_cr" min="0" step="1" max="255" shortname="green_margin_cr"/>
        <!-- <dl_setting var="green.draw" min="0" step="1" max="1" values="False|True" shortname="draw green"/> -->

        <dl_setting var="orange.lum" min="0" step="1" max="255" shortname="orange_y"/>
        <dl_setting var="orange.cb" min="0" step="1" max="255" shortname="orange_u"/>
        <dl_setting var="orange.cr" min="0" step="1" max="255" shortname="orange_v"/>
        <dl_setting var="orange.margin_lum" min="0" step="1" max="255" shortname="orange_margin_lum"/>
        <dl_setting var="orange.margin_cb" min="0" step="1" max="255" shortname="orange_margin_cb"/>
        <dl_setting var="orange.margin_cr" min="0" step="1" max="255" shortname="orange_margin_cr"/>
        <!-- <dl_setting var="orange.draw" min="0" step="1" max="1" values="False|True" shortname="draw orange"/> -->

        <dl_setting var="purple.lum" min="0" step="1" max="255" shortname="purple_y"/>
        <dl_setting var="purple.cb" min="0" step="1" max="255" shortname="purple_u"/>
        <dl_setting var="purple.cr" min="0" step="1" max="255" shortname="purple_v"/>
        <dl_setting var="purple.margin_lum" min="0" step="1" max="255" shortname="purple_margin_lum"/>
        <dl_setting var="purple.margin_cb" min="0" step="1" max="255" shortname="purple_margin_cb"/>
        <dl_setting var="purple.margin_cr" min="0" step="1" max="255" shortname="purple_margin_cr"/>
        <!-- <dl_setting var="purple.draw" min="0" step="1" max="1" values="False|True" shortname="draw purple"/> -->

        <dl_setting var="brown.lum" min="0" step="1" max="255" shortname="brown_y"/>
        <dl_setting var="brown.cb" min="0" step="1" max="255" shortname="brown_u"/>
        <dl_setting var="brown.cr" min="0" step="1" max="255" shortname="brown_v"/>
        <dl_setting var="brown.margin_lum" min="0" step="1" max="255" shortname="brown_margin_lum"/>
        <dl_setting var="brown.margin_cb" min="0" step="1" max="255" shortname="brown_margin_cb"/>
        <dl_setting var="brown.margin_cr" min="0" step="1" max="255" shortname="brown_margin_cr"/>
        <!-- <dl_setting var="brown.draw" min="0" step="1" max="1" values="False|True" shortname="draw brown"/> -->
      </dl_settings>
    </dl_settings>
  </settings>

  <dep>
    <depends>video_thread</depends>
  </dep>

  <header>
    <file name="ray_paths.h"/>
  </header>

  <init fun="ray_paths_init()"/>
  <periodic fun="ray_paths_periodic()" freq="10"/>
  <makefile target="ap|nps">
    <file name="ray_paths.c"/>
  </makefile>
</module>

