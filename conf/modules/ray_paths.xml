<!DOCTYPE module SYSTEM "module.dtd">

<module name="ray_paths">
  <doc>
    <description>Ray Path Finder
    Detects the best path by casting rays and giving them a score

    </description>
    <define name="RAY_PATH_FINDER_CAMERA1" value="front_camera|bottom_camera" description="Video device to use"/>
    <define name="RAY_PATH_FINDER_FPS1" value="0" description="Desired FPS (0: camera rate)"/>

    <define name="RAY_PATH_FINDER_GREEN_LUM_MIN" value="0" description="Green minimum luminance"/>
    <define name="RAY_PATH_FINDER_GREEN_LUM_MAX" value="255" description="Green maximum luminance"/>
    <define name="RAY_PATH_FINDER_GREEN_CB_MIN" value="0" description="Green minimum blue chroma"/>
    <define name="RAY_PATH_FINDER_GREEN_CB_MAX" value="255" description="Green maximum blue chroma"/>
    <define name="RAY_PATH_FINDER_GREEN_CR_MIN" value="0" description="Green minimum red chroma"/>
    <define name="RAY_PATH_FINDER_GREEN_CR_MAX" value="255" description="Green maximum red chroma"/>

    <define name="RAY_PATH_FINDER_ORANGE_LUM_MIN" value="0" description="Orange minimum luminance"/>
    <define name="RAY_PATH_FINDER_ORANGE_LUM_MAX" value="255" description="Orange maximum luminance"/>
    <define name="RAY_PATH_FINDER_ORANGE_CB_MIN" value="0" description="Orange minimum blue chroma"/>
    <define name="RAY_PATH_FINDER_ORANGE_CB_MAX" value="255" description="Orange maximum blue chroma"/>
    <define name="RAY_PATH_FINDER_ORANGE_CR_MIN" value="0" description="Orange minimum red chroma"/>
    <define name="RAY_PATH_FINDER_ORANGE_CR_MAX" value="255" description="Orange maximum red chroma"/>

    <define name="RAY_PATH_FINDER_PURPLE_LUM_MIN" value="0" description="Purple minimum luminance"/>
    <define name="RAY_PATH_FINDER_PURPLE_LUM_MAX" value="255" description="Purple maximum luminance"/>
    <define name="RAY_PATH_FINDER_PURPLE_CB_MIN" value="0" description="Purple minimum blue chroma"/>
    <define name="RAY_PATH_FINDER_PURPLE_CB_MAX" value="255" description="Purple maximum blue chroma"/>
    <define name="RAY_PATH_FINDER_PURPLE_CR_MIN" value="0" description="Purple minimum red chroma"/>
    <define name="RAY_PATH_FINDER_PURPLE_CR_MAX" value="255" description="Purple maximum red chroma"/>

    <define name="RAY_PATH_FINDER_BROWN_LUM_MIN" value="0" description="Brown minimum luminance"/>
    <define name="RAY_PATH_FINDER_BROWN_LUM_MAX" value="255" description="Brown maximum luminance"/>
    <define name="RAY_PATH_FINDER_BROWN_CB_MIN" value="0" description="Brown minimum blue chroma"/>
    <define name="RAY_PATH_FINDER_BROWN_CB_MAX" value="255" description="Brown maximum blue chroma"/>
    <define name="RAY_PATH_FINDER_BROWN_CR_MIN" value="0" description="Brown minimum red chroma"/>
    <define name="RAY_PATH_FINDER_BROWN_CR_MAX" value="255" description="Brown maximum red chroma"/>
  </doc>

 <settings>
    <dl_settings>
      <dl_settings name="RayPathFinder">

        <dl_setting var="turning_threshold" min="-20" step="1" max="20" shortname="turning threshold"/>

        <dl_setting var="ratio_setting" min="0" step="1" max="50" shortname="ratio setting"/>

        <dl_setting var="green.lum_min" min="0" step="1" max="255" shortname="green_lum_min"/>
        <dl_setting var="green.lum_max" min="0" step="1" max="255" shortname="green_lum_max"/>
        <dl_setting var="green.cb_min" min="0" step="1" max="255" shortname="green_cb_min"/>
        <dl_setting var="green.cb_max" min="0" step="1" max="255" shortname="green_cb_max"/>
        <dl_setting var="green.cr_min" min="0" step="1" max="255" shortname="green_cr_min"/>
        <dl_setting var="green.cr_max" min="0" step="1" max="255" shortname="green_cr_max"/>
        <!-- <dl_setting var="green.draw" min="0" step="1" max="1" values="False|True" shortname="green_draw"/> -->

        <dl_setting var="orange.lum_min" min="0" step="1" max="255" shortname="orange_lum_min"/>
        <dl_setting var="orange.lum_max" min="0" step="1" max="255" shortname="orange_lum_max"/>
        <dl_setting var="orange.cb_min" min="0" step="1" max="255" shortname="orange_cb_min"/>
        <dl_setting var="orange.cb_max" min="0" step="1" max="255" shortname="orange_cb_max"/>
        <dl_setting var="orange.cr_min" min="0" step="1" max="255" shortname="orange_cr_min"/>
        <dl_setting var="orange.cr_max" min="0" step="1" max="255" shortname="orange_cr_max"/>
        <!-- <dl_setting var="orange.draw" min="0" step="1" max="1" values="False|True" shortname="orange_draw"/> -->

        <dl_setting var="purple.lum_min" min="0" step="1" max="255" shortname="purple_lum_min"/>
        <dl_setting var="purple.lum_max" min="0" step="1" max="255" shortname="purple_lum_max"/>
        <dl_setting var="purple.cb_min" min="0" step="1" max="255" shortname="purple_cb_min"/>
        <dl_setting var="purple.cb_max" min="0" step="1" max="255" shortname="purple_cb_max"/>
        <dl_setting var="purple.cr_min" min="0" step="1" max="255" shortname="purple_cr_min"/>
        <dl_setting var="purple.cr_max" min="0" step="1" max="255" shortname="purple_cr_max"/>
        <!-- <dl_setting var="purple.draw" min="0" step="1" max="1" values="False|True" shortname="purple_draw"/> -->

        <dl_setting var="brown.lum_min" min="0" step="1" max="255" shortname="brown_lum_min"/>
        <dl_setting var="brown.lum_max" min="0" step="1" max="255" shortname="brown_lum_max"/>
        <dl_setting var="brown.cb_min" min="0" step="1" max="255" shortname="brown_cb_min"/>
        <dl_setting var="brown.cb_max" min="0" step="1" max="255" shortname="brown_cb_max"/>
        <dl_setting var="brown.cr_min" min="0" step="1" max="255" shortname="brown_cr_min"/>
        <dl_setting var="brown.cr_max" min="0" step="1" max="255" shortname="brown_cr_max"/>
        <!-- <dl_setting var="brown.draw" min="0" step="1" max="1" values="False|True" shortname="brown_draw"/> -->
      </dl_settings>
    </dl_settings>
  </settings>

  <dep>
    <depends>video_thread</depends>
  </dep>

  <header>
    <file name="ray_paths.h"/>
  </header>

  <init fun="ray_paths_init()"/>
  <periodic fun="ray_paths_periodic()" freq="10"/>
  <makefile target="ap|nps">
    <file name="ray_paths.c"/>
  </makefile>
</module>

