<!DOCTYPE module SYSTEM "module.dtd">

<module name="safest_bearing">
  <doc>
    <description>Color Object Detector
    Detects an object by a continuous color. Optionally draws on image.
    </description>
  </doc>
  <settings>
    <dl_settings>
      <dl_settings name="Safest Bearing">
         <dl_setting var="confidence_th" min="1" step="1" max="100"/>
      </dl_settings>
    </dl_settings>
  </settings>

  <dep>
    <depends>video_thread</depends>
  </dep>

  <header>
    <file name="safest_bearing.h"/>
  </header>

  <init fun="safest_bearing_init()"/>
  <periodic fun="safest_bearing_periodic()" freq="50"/>
  <makefile target="ap|nps">
    <file name="safest_bearing.c"/>
    <file name="bearing_model.c"/>
  </makefile>
</module>

